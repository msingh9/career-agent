# Optional: free API key from https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# OpenAI
OPENAI_API_KEY=
# General agentic work (chat, fit analysis, materials, summaries) — cheap/fast.
OPENAI_MODEL=gpt-4o-mini
# Resume digestion only (run once per resume upload) — a stronger model.
OPENAI_DIGEST_MODEL=gpt-5.2

# Default search criteria (comma-separated) — used when no profile exists
SEARCH_TITLES=VP,Senior Director,Director
SEARCH_KEYWORDS=semiconductor,semiconductors,chip,fab,ASIC,foundry,wafer,EDA,GPU,CPU,analog,mixed-signal
SEARCH_LOCATIONS=

# Auto-apply in your real Google Chrome (reuses your logged-in sessions).
# Start Chrome with: .\start-chrome-debug.ps1  (classic remote debugging).
# Leave blank to use a throwaway Chromium launched by Playwright instead.
CHROME_CDP_URL=http://127.0.0.1:9333
